network publica (outbound = 'yes')
network privada ()

system front (
cpu.count>=1 and
memory.size>=2g and
net_interface.1.connection = 'publica' and
net_interface.0.connection = 'privada' and
net_interface.0.ip = '10.10.2.245' and 
net_interface.0.dns_name = 'jenkinserver' and
disk.0.os.name='linux' and
disk.0.os.flavour='ubuntu' and
disk.0.image.url = ''
)

configure front (
@begin
- tasks:
  - name: Reinstall CA certificates
    apt:
      name: ca-certificates
      state: latest
      update_cache: yes


  #Install Java
  - name: Update the system
    shell: apt update

  # Asegurarnos de que esté instalado ufw
  - name: Ensure ufw is installed
    apt:
      name: ufw
      state: present
      update_cache: yes

  # Permitir tráfico SSH (puerto 22)
  - name: Allow SSH (port 22)
    ufw:
      rule: allow
      port: 22
      proto: tcp

  # Permitir tráfico HTPPS (puerto 443)
  - name: Allow HTTPS(port 443)
    ufw:
      rule: allow
      port: 443
      proto: tcp

  # Permitir tráfico para Jenkins (puerto 8080)
  - name: Allow Jenkins (port 8080)
    ufw:
      rule: allow
      port: 8080
      proto: tcp

  # Habilitar ufw
  - name: Enable ufw
    ufw:
      state: enabled
      logging: on

  - name: Ensure SSH is enabled and started
    service:
      name: ssh
      state: started
      enabled: true

  - name: Install Openjdk 17. Jenkins need the 17 version or newer
    shell: apt install openjdk-17-jdk -y

  # Install Jenkins
  - name: Update the system
    shell: apt update

  - name: Add Jenkins apt repository key
    apt_key:
      url: "https://pkg.jenkins.io/debian-stable/jenkins.io-2023.key"
      state: present

  - name: Add the Jenkins apt repository
    apt_repository:
      repo: "deb https://pkg.jenkins.io/debian-stable binary/"
      state: present
      update_cache: true

  - name: Update the system
    shell: apt update
    
  - name: solve error installing Jenkins
    shell: add-apt-repository universe
  
  - name: Install Jenkins
    shell: apt install jenkins -y --allow-unauthenticated --no-upgrade jenkins
  
  - name: Install gcc
    shell: apt install -y build-essential

  - name: Install bc calculator
    shell: apt install -y bc


  # Install AzCopy
  - name: Download AzCopy tar.gz archive
    shell: wget https://aka.ms/downloadazcopy-v10-linux -O /tmp/azcopy.tar.gz

  - name: Extract AzCopy archive
    shell: tar -xvf /tmp/azcopy.tar.gz -C /tmp

  - name: Copy AzCopy binary to /usr/bin
    shell: cp /tmp/azcopy_linux_amd64_*/azcopy /usr/bin/azcopy

  - name: Make AzCopy binary executable
    shell: chmod +x /usr/bin/azcopy

  - name: Clean up temporary files
    shell: rm -rf /tmp/azcopy.tar.gz /tmp/azcopy_linux_amd64_*
    
  - name: Verify AzCopy installation
    shell: azcopy --version


  # Install Autoasssesment scrips from Github
  - name: Install Autoasssesment scrips from Github
    git:
      repo: https://github.com/grycap/ACTaaS
      dest: /var/tmp/education/ACTaaS
      version: master

  - name: Set permisions for unittest scripts
    file:
      path: /var/tmp/education/ACTaaS/practices/P1/Face/unittests
      state: directory
      recurse: yes
      owner: root
      group: root
      mode: '0777'

  - name: Set permisions for unittest directory
    file:
      path: /var/tmp/education/ACTaaS/practices/P1/Face/unittests
      state: directory
      mode: '0755'  
@end
)



deploy front 1
